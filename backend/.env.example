# SAHAYAK V6 backend configuration
# Add environment variables here as the project grows.
# APP_ENV=development
WHISPER_MODEL=base
# Multilingual semantic NLP
SAHAYAK_SEMANTIC_ENABLED=true
SAHAYAK_SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SAHAYAK_SEMANTIC_THRESHOLD=0.55

# Server-side video footage analysis (uploaded video files)
# SAHAYAK_MEDIAPIPE_DIR=./models_cache   # where face/hand/pose .task files are cached
# SAHAYAK_VIDEO_FPS=12                    # frames per second sampled from uploads
# SAHAYAK_VIDEO_MAX_SEC=600               # analyse at most this many seconds
